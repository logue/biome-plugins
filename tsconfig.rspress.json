{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "include": [
    "env.d.ts",
    "src-docs/**/*"
  ],
  "exclude": [
    "**/node_modules"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "docs",
    "types": [
      "@rsbuild/core/types",
      "node"
    ],
    "lib": [
      "DOM",
      "ESNext"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "useDefineForClassFields": true,
    /* modules */
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    /* type checking */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.rspress.tsbuildinfo",
  },
  "mdx": {
    "checkMdx": true
  }
}