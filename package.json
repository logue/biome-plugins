{
  "name": "@logue/biome-plugins",
  "version": "0.0.4",
  "description": "Custom Biome lint rules written as GritQL plugins",
  "keywords": [
    "biome",
    "gritql",
    "lint",
    "rstack"
  ],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/biome-plugins",
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/biome-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/logue/biome-plugins/issues"
  },
  "packageManager": "pnpm@12.8.1",
  "files": [
    "grit/",
    "!grit/__tests__",
    "biome-manifest.jsonc"
  ],
  "exports": {
    "./biome": "./biome.jsonc"
  },
  "scripts": {
    "dev": "rs doc",
    "lint": "run-s 'lint:*' --",
    "lint:biome": "biome check --write",
    "lint:rslint": "rs lint . --fix",
    "build": "rs doc build",
    "preview": "rs doc preview",
    "test": "rs test",
    "test:watch": "rs test --watch",
    "clean": "rimraf dist docs",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.cache"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.5.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@carbon/styles": "^1.116.0",
    "@carbon/web-components": "^2.64.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/markdown": "^8.0.3",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rspress/core": "^2.0.23",
    "@rstest/core": "^0.12.3",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-config-prettier": "^10.1.8",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "rstack": "^0.8.0",
    "typescript": "^7.0.2"
  }
}
