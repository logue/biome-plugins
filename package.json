{
  "name": "@logue/biome-plugins",
  "version": "0.0.4",
  "description": "Custom Biome lint rules written as GritQL plugins",
  "keywords": [
    "biome",
    "gritql",
    "lint",
    "rstack"
  ],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/biome-plugins",
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/biome-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/logue/biome-plugins/issues"
  },
  "packageManager": "pnpm@12.5.1",
  "files": [
    "grit/",
    "!grit/__tests__",
    "biome-manifest.jsonc"
  ],
  "exports": {
    "./biome": "./biome.jsonc"
  },
  "scripts": {
    "dev": "rspress dev",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rslint . --fix",
    "lint:biome": "biome check --write",
    "build": "rspress build",
    "preview": "rspress preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "clean": "rimraf dist docs",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.cache"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.5.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@carbon/styles": "^1.115.0",
    "@carbon/web-components": "^2.63.0",
    "@changesets/cli": "^3.0.3",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rslint/core": "^0.9.3",
    "@rspress/core": "^2.0.22",
    "@rstest/core": "^0.12.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
