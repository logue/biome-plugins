{
  "name": "@logue/biome-plugins",
  "version": "0.0.1",
  "description": "Custom Biome lint rules written as GritQL plugins",
  "keywords": [
    "biome",
    "gritql",
    "lint",
    "rstack"
  ],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/biome-plugins",
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/biome-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/logue/biome-plugins/issues"
  },
  "packageManager": "pnpm@11.22.0",
  "files": [
    "grit",
    "plugins",
    "skills"
  ],
  "pi": {
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "dev": "rspress dev",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rslint .",
    "lint:biome": "biome check --write",
    "build": "rspress build",
    "preview": "rspress preview",
    "clean": "rimraf dist docs",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.cache"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.5.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@carbon/styles": "^1.113.0",
    "@carbon/web-components": "^2.61.0",
    "@changesets/cli": "^3.0.1",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rslint/core": "^0.8.1",
    "@rspress/core": "^2.0.19",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
