// [Basis] The src directory should not contain anything other than source code and tightly coupled unit tests.
// Demos (src-demo) and Storybook content should be placed outside of src because they should represent the library as it is viewed from the outside.
//
// ✗ import Demo from '../src-demo/MyDemo.vue' // Import demo within src/
// ✓ import MyComponent from './MyComponent.vue' // Reference only to production code

contains `import $any from $path` as $m where {
  // 1. 解析対象ファイルが src/ 内にある場合（$filename は絶対パスで渡ってくる）
  $filename <: r".*/src/.*",
  // 2. そのファイルが Storybook や デモ（Sandbox）のコードをインポートしようとしたらエラー
  $path <: r".*(?:storybook|demo|sandbox|preview).*",
  register_diagnostic(span=$m, message="The `src` directory may only contain production code and test code. External content such as Storybooks and demos should be placed outside the `src` directory (e.g., `src-demo`) and referenced as an external module.", severity="error")
}
