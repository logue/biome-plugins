// [Rationale] `undefined` is TypeScript's canonical "no value" (`Partial<T>` uses it).
// Mixing `null` creates two ways to express the same absence and complicates every
// consuming type. Use optional (`?`) instead.
//
// ✗  function process(str: string | null) {}
// ✓  function process(str?: string) {}
//
// Exception — JSON transformation boundary only:
//   const normalized = { value: apiData.value ?? undefined };
//
// [Implementation note] GritQL's snippet parser cannot bind a metavariable that sits
// directly in front of a `:` type annotation (`$param: $type` never matches), so this
// rule targets the CST nodes that carry a type annotation directly (function/arrow
// parameters, variable declarators, class fields) and checks their source text for a
// `null` union member.

engine biome(1.0)
language js(typescript)

or {
  JsFormalParameter(),
  JsVariableDeclarator(),
  JsPropertyClassMember()
} as $m where {
  $m <: r".*\bnull\b.*",
  register_diagnostic(span=$m, message="Avoid `null` in type annotations. Use optional (`?`) instead, or `| undefined`. Exception: JSON transformation boundaries only.", severity="warn")
}
