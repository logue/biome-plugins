{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "name": "@logue/biome-plugins",
  "version": "0.0.3",
  "rules": [
    "grit/enforce-attribute-order.grit",
    "grit/enforce-pure-src.grit",
    "grit/prefer-union-over-enum.grit",
    "grit/no-null-type.grit",
    "grit/vue-multi-word-filename.grit"
  ]
}
