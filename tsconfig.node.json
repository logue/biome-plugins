{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "include": [
    "env.d.ts",
    "package.json",
    "rsbuild.config.*",
    "rslib.config.*",
    "rslint.config.*",
    "rspress.config.*"
  ],
  "exclude": [
    "**/.*/",
    "**/node_modules"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}